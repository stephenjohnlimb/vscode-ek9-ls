{
	"name": "ek9-ls",
	"displayName": "EK9 Extension",
	"description": "Language Server Extension for EK9",
	"version": "0.0.1",
	"publisher": "stephenjohnlimb",
	"repository": "https://github.com/stephenjohnlimb/vscode-ek9-ls",
	"engines": {
		"vscode": "^1.53.0"
	},
	"categories": [],
	"activationEvents": [
		"onLanguage:ek9",
		"onDebugResolve:ek9"
	],
	"main": "./out/extension.js",
	"contributes": {
    "snippets": [
      {
        "language": "ek9",
        "path": "./snippets/snippets.json"
      }
    ],
		"configuration": {
			"type": "object",
			"title": "EK9 Java Command",
			"properties": {
        "ek9-ls.useNative": {
					"scope": "window",
					"type": "boolean",
					"default": false,
					"description": "Use the native EK9 compiler."
				},
				"ek9-ls.javaCommand": {
					"scope": "window",
					"type": "string",
					"default": "",
					"description": "The file path to Java (if not using native)."
				},
				"ek9-ls.compilerPath": {
					"scope": "window",
					"type": "string",
					"default": "",
					"description": "The file path to ek9.jar or path to native command."
				},
        "ek9-ls.languageHelp": {
					"scope": "window",
					"type": "boolean",
					"default": true,
					"description": "Is Hover/Help required for EK9."
				},
        "ek9-ls.debugVerbose": {
					"scope": "window",
					"type": "boolean",
					"default": false,
					"description": "Verbose diagnostic logging for the EK9 language server itself, shown in the VS Code output window. This is language-server logging, NOT debugging an EK9 program (see ek9-ls.debugAdapterPort for that)."
				},
        "ek9-ls.debugAdapterPort": {
					"scope": "window",
					"type": "number",
					"default": 0,
					"description": "Development override: if set to a non-zero TCP port, the extension CONNECTS to a standalone EK9 debug adapter already listening there (for iterating on the adapter without repackaging). Leave at 0 to SPAWN 'ek9 -dap' using ek9-ls.javaCommand/ek9-ls.compilerPath (the normal path)."
				}
			}
		},
		"breakpoints": [
			{
				"language": "ek9"
			}
		],
		"debuggers": [
			{
				"type": "ek9",
				"label": "EK9 Debug",
				"languages": [
					"ek9"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "Path to the compiled EK9 jar (e.g. .ek9/<name>.jar, built with debug info via 'ek9 -Cg') to launch under the debugger. The adapter starts it under JDWP and routes its output to the Debug Console."
							},
							"cwd": {
								"type": "string",
								"description": "Working directory for the launched program."
							},
							"seed": {
								"type": "integer",
								"description": "The random seed the program's SystemRandom and OS.random draw from, so a run can be repeated exactly. Left out, each launch has a new one, shown in the Debug Console - put that one here to repeat the run."
							}
						}
					},
					"attach": {
						"required": [
							"hostName",
							"port"
						],
						"properties": {
							"hostName": {
								"type": "string",
								"description": "Host of the JDWP debuggee to attach to.",
								"default": "127.0.0.1"
							},
							"port": {
								"type": "number",
								"description": "JDWP port of the debuggee (server=y,suspend=y).",
								"default": 5005
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "ek9",
						"request": "launch",
						"name": "EK9: Launch program",
						"program": "${workspaceFolder}/.ek9/program.jar"
					},
					{
						"type": "ek9",
						"request": "attach",
						"name": "EK9: Attach to debuggee (5005)",
						"hostName": "127.0.0.1",
						"port": 5005
					}
				]
			}
		],
		"languages": [
			{
				"id": "ek9",
				"aliases": [
					"ek9"
				],
				"extensions": [
					".ek9"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "ek9",
				"scopeName": "source.ek9",
				"path": "./syntaxes/ek9.tmLanguage"
			}
		],
		"commands": [
			{
				"command": "ek9-ls.restartServer",
				"title": "EK9 Language Server: Restart server"
			},
			{
				"command": "ek9-ls.killServer",
				"title": "EK9 Language Server: Kill server"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint . --ext .ts,.tsx",
		"watch": "tsc -watch -p ./"
	},
	"dependencies": {
		"vscode-languageclient": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^12.12.6",
		"@types/vscode": "^1.53.0",
		"@typescript-eslint/eslint-plugin": "^4.9.0",
		"@typescript-eslint/parser": "^4.9.0",
		"typescript": "^4.1.2",
		"eslint": "^7.15.0"
	}
}
